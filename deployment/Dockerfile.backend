FROM python:3.11-slim

WORKDIR /app/backend

# System deps for dnspython, cryptography, wheels + Türkçe/Arapça PDF fontları
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libssl-dev libffi-dev curl \
    fonts-dejavu-core fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/ \
    -r /app/backend/requirements.txt

COPY . /app/backend

EXPOSE 8001

# Uvicorn with 2 workers — production ready
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2", "--proxy-headers"]
