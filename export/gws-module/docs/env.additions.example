# cyber-security-18 backend/.env için EKLENMESİ GEREKENLER
# =========================================================
# Bu değerleri /app/backend/.env dosyasının SONUNA ekleyin — mevcut satırları
# silmeyin veya değiştirmeyin.

# ---- GökyüzüWebSpam modülü ----

# Plugin mode: seller = satıcı (admin) modu, customer = müşteri (7-gün demo) modu
MAILSHIELD_MODE=seller

# Stripe (test kartı 4242 4242 4242 4242 ile test için sk_test_emergent yeterli)
# Production için Stripe dashboard'dan sk_live_XXX alın
STRIPE_API_KEY=sk_test_emergent
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# License server cluster (opsiyonel — kurmayacaksanız `disabled` yapın)
PUBLIC_LICENSE_SERVER_URL=http://localhost:8002
LICENSE_SERVER_REGIONS=Primary EU-West
LICENSE_SERVER_ADMIN_KEY=CHANGE_ME_WITH_openssl_rand_hex_32
LICENSE_SERVER_REDIS_URL=redis://localhost:6379/0
LICENSE_SERVER_RATE_LIMIT=120
LICENSE_SERVER_CACHE_TTL=60

# Reseller JWT — bu değeri MUTLAKA production'da değiştirin
RESELLER_JWT_SECRET=CHANGE_ME_WITH_openssl_rand_hex_32

# Emergent LLM (AI kural üretimi için — mevcutsa dokunmayın)
# EMERGENT_LLM_KEY=<mevcut değeri koruyun>

# Frontend'e gösterilecek domain (deployment sonrası)
# PUBLIC_APP_URL=https://gokyuzubilgisayar.com
