[Unit]
Description=GokyuzuWebSpam MailScanner Log Adapter (tail -F -> SaaS ingest)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/mailshield/bin/mailshield-logtail.pl
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/mailshield/logtail.log
StandardError=append:/var/log/mailshield/logtail.log
User=root
Group=root
Nice=10

[Install]
WantedBy=multi-user.target
