[% SET pagetitle="GokyuzuWebSpam" %]
[% Whostmgr.header(pagetitle) %]

<style>
  /* WHM chrome (nav/sidebar) korunur, sadece bizim iframe konteynerimiz stillenir */
  .ms-container {
    padding: 0;
    margin: 0 -10px 0 -10px;   /* WHM padding'ini iptal etmek için negative margin */
    background: #0f172a;
    border-radius: 0;
  }
  .ms-container iframe {
    display: block;
    width: 100%;
    height: calc(100vh - 200px);   /* WHM header + nav'ı çıkardıktan sonra kalan */
    min-height: 600px;
    border: 0;
    background: #0f172a;
  }
  .ms-info-bar {
    padding: 6px 12px;
    background: #f8fafc;
    border-bottom: 1px solid #e5e7eb;
    font-size: 11px;
    color: #64748b;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ms-info-bar a {
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
    padding: 3px 10px;
    border: 1px solid #dbeafe;
    border-radius: 12px;
    background: #eff6ff;
  }
  .ms-info-bar a:hover { background: #dbeafe; }
</style>

<div class="ms-container">
  <div class="ms-info-bar">
    <span>GokyuzuWebSpam &mdash; Mail Guvenlik Paneli</span>
    <a href="/cgi/mailshield/index.cgi" target="_blank" rel="noopener">Tam Ekran &rarr;</a>
  </div>
  <iframe src="https://panel.gokyuzuhosting.com/panel" title="GokyuzuWebSpam Panel" allow="clipboard-read; clipboard-write; fullscreen"></iframe>
</div>

<script>
  // WHM main content area padding'ini de azalt ki iframe daha büyük görünsün
  (function(){
    try {
      var containers = ['contentContainer', 'pageContainer', 'main-content'];
      for (var i = 0; i < containers.length; i++) {
        var el = document.getElementById(containers[i]);
        if (el) { el.style.padding = '4px'; el.style.margin = '0'; }
      }
    } catch(_){}
  })();
</script>

[% Whostmgr.footer() %]
