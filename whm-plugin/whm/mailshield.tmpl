[% USE Whostmgr %]
[% Whostmgr.header('GokyuzuWebSpam') %]

<style>
  /* v43.7 fullscreen fix — WHM chrome padding'i temizle, iframe viewport'un tamamını kullansın */
  html, body { margin: 0 !important; padding: 0 !important; overflow: hidden !important; }
  #contentContainer, .pageContainer, #cptext { padding: 0 !important; margin: 0 !important; max-width: none !important; }
  #ms-header { padding: 8px 16px; background: #f8fafc; border-bottom: 1px solid #e5e7eb; height: 56px; box-sizing: border-box; }
  #ms-header h2 { margin: 0; font-size: 15px; color: #1e3a8a; line-height: 1.2; }
  #ms-header p { margin: 2px 0 0 0; color: #666; font-size: 11px; line-height: 1.2; }
  #ms-shell { position: relative; width: 100vw; height: calc(100vh - 56px); border: 0; display: block; }
</style>

<div id="ms-header">
  <h2>GokyuzuWebSpam</h2>
  <p>Modern mail guvenligi paneli · Canli lisans sunucusu ile senkronize</p>
</div>
<iframe id="ms-shell" src="https://panel.gokyuzuhosting.com/panel" title="GokyuzuWebSpam" allow="fullscreen"></iframe>

[% Whostmgr.footer() %]
