# =============================================================================
# GökyüzüWebSpam — Custom SpamAssassin Rules (v44.00.46)
# =============================================================================
# Bu dosyayı mail sunucunuzda SpamAssassin custom rules klasörüne kopyalayın:
#   /etc/mail/spamassassin/GokyuzuWebSpam.cf    (WHM/cPanel varsayilan)
# veya
#   /var/lib/mailscanner/local.cf              (MailScanner override)
#
# Sonra SpamAssassin'i reload edin:
#   sa-compile
#   systemctl restart spamassassin
#   /usr/mailscanner/bin/check_spamassassin --lint
#
# Kural amaci: SA'nin varsayilan olarak yakalayamadigi kimlik taklidi (display
# name spoofing) ve Turk kurumsal ortama zararli phishing paterni.
# =============================================================================

# --- 1) FROM-name = alici domain'i taklidi (5.5 puan) -----------------------
# Ornekler:
#   From: handizayn.com <miya@skyverticals.com>
#   From: "your-bank.com" <hacker@evil.com>
# Bunlar klasik phishing paterni. SA cogunlukla yakalayamaz.
#
# Bu regex, From: header'da display name olarak bir domain gorurse ve o domain
# envelope-from domain'inden farkli ise +5.5 puan verir.

header  GWS_FROM_SPOOF_DISPLAY_HAS_DOMAIN  From =~ /(?:^|["\s])([a-z0-9][a-z0-9-]{1,62}\.(?:com|net|org|com\.tr|net\.tr|org\.tr|info|biz|co|io|xyz|top))\s*<[^@>]+@(?!\1)[a-z0-9.-]+>/i
score   GWS_FROM_SPOOF_DISPLAY_HAS_DOMAIN  7.5
describe GWS_FROM_SPOOF_DISPLAY_HAS_DOMAIN Display name bir domain gibi gorunuyor ama gercek gonderici farkli — kimlik taklidi

# --- 2) Kurumsal "Mailbox Full / Kota" phishing paterni (3.0 puan) ---------
# Turkce ve Ingilizce varyantlar
header   __GWS_MAILBOX_FULL_SUBJ_TR  Subject =~ /(?:posta\s*kutu(?:s[uü])?|kota|depolama).{0,20}(?:dolu|doldu|%\s*9\d|yeterli\s+alan)/i
header   __GWS_MAILBOX_FULL_SUBJ_EN  Subject =~ /(?:mailbox|storage|quota).{0,20}(?:full|exceed|limit|99\s*%)/i
meta     GWS_PHISH_MAILBOX_FULL  ( __GWS_MAILBOX_FULL_SUBJ_TR || __GWS_MAILBOX_FULL_SUBJ_EN )
score    GWS_PHISH_MAILBOX_FULL  3.0
describe GWS_PHISH_MAILBOX_FULL  Klasik "posta kutunuz dolu" phishing paterni

# --- 3) Sifre sifirlama / hesap askiya alindi paterni (2.5 puan) -----------
header   __GWS_ACCT_SUSPEND_SUBJ  Subject =~ /(?:hesab[ıi]n[ıi]z|account).{0,20}(?:ask[ıi]ya|suspend|kilit|lock|dondur)/i
score    __GWS_ACCT_SUSPEND_SUBJ  2.5
describe __GWS_ACCT_SUSPEND_SUBJ  Sifre sifirlama / hesap askiya alindi paterni

# --- 4) URL kisaltici + kurumsal from taklidi (3.5 puan) --------------------
# Butun body kisaltici link + display name kurumsal → tehlikeli
uri      __GWS_URL_SHORTENER  m{https?://(?:bit\.ly|goo\.gl|tinyurl\.com|ow\.ly|t\.co|is\.gd|buff\.ly|adf\.ly|shorte\.st|cutt\.ly)/}i
meta     GWS_SHORTENER_WITH_SPOOF  ( __GWS_URL_SHORTENER && GWS_FROM_SPOOF_DISPLAY_HAS_DOMAIN )
score    GWS_SHORTENER_WITH_SPOOF  3.5
describe GWS_SHORTENER_WITH_SPOOF  URL kisaltici + kimlik taklidi (compound risk)

# --- 5) DKIM valid ama envelope-from domain match etmiyor (2.0 puan) -------
# Attacker DKIM aliyor own domain'inde ama From header'da baska domain gosteriyor
# NOT: SA'nin DKIM_ADSP_ALL / DKIM_ADSP_DISCARD ile ust uste dusebilir; ozel
# olarak "envelope domain != From header domain" durumunu isaretler.
header   __GWS_ENV_FROM_MISMATCH  ALL =~ /^Return-Path:\s*<[^@]+@([a-z0-9.-]+)>.*?^From:\s*[^<]*<[^@]+@(?!\1)([a-z0-9.-]+)>/msi
score    __GWS_ENV_FROM_MISMATCH  2.0
describe __GWS_ENV_FROM_MISMATCH  Return-Path domain != From header domain

# =============================================================================
# v44.00.46 — MALWARE / EXECUTABLE URL DEFENSE
# =============================================================================
# Body veya URI icinde .jar/.exe/.scr/.vbs/.js/.msi/.hta gibi executable
# uzantili link → yuksek puan. Panel de ayni tesbiti yapip verdict=malware
# koyar; SA ayrica MTA seviyesinde extra guvence saglar.

uri      __GWS_URL_EXEC_EXT  m{https?://[^\s]{0,300}\.(?:jar|exe|scr|vbs|js|msi|bat|cmd|hta|ps1|com|pif|apk|dll)(?:\?|$|["'<>\s])}i
score    __GWS_URL_EXEC_EXT  6.5
describe __GWS_URL_EXEC_EXT  Body'de dogrudan calistirilabilir dosya download linki (RAT/trojan taşiyicisi)

# Google Drive / Dropbox / OneDrive dogrudan indirme URL'i - klasik payload lure
uri      __GWS_CLOUD_DL_LURE  m{(?:drive\.google\.com/(?:uc\?export=download|file/d/)|dropbox\.com/s/|onedrive\.live\.com/download|mediafire\.com/file/|wetransfer\.com/downloads/|sendspace\.com/file/)}i
score    __GWS_CLOUD_DL_LURE  4.0
describe __GWS_CLOUD_DL_LURE  Cloud file-share dogrudan indirme linki (phishing payload lure)

# Türkçe phishing tuzak metni ("dosyayı görüntüle", "belgeyi görüntüle" vs.)
body     __GWS_TR_PHISH_LURE  /(?:dosyay[ıi]\s*g[oö]r[uü]nt[uü]le|belgey[ıi]\s*g[oö]r[uü]nt[uü]le|dosyay[ıi]\s*a[cç]|belgey[ıi]\s*indir|faturay[ıi]\s*g[oö]r[uü]nt[uü]le|ekli\s*belge|ekli\s*dosya)/i

# Cloud DL + Türkçe lure kombosu (compound risk — kesin phishing)
meta     GWS_MALWARE_CLOUD_TR_LURE  ( __GWS_CLOUD_DL_LURE && __GWS_TR_PHISH_LURE )
score    GWS_MALWARE_CLOUD_TR_LURE  5.5
describe GWS_MALWARE_CLOUD_TR_LURE  Turkce "dosyayi goruntule" + cloud indirme linki = kesin phishing

# Executable URL + Türkçe lure kombosu
meta     GWS_MALWARE_EXEC_TR_LURE  ( __GWS_URL_EXEC_EXT && __GWS_TR_PHISH_LURE )
score    GWS_MALWARE_EXEC_TR_LURE  4.0
describe GWS_MALWARE_EXEC_TR_LURE  Turkce lure + executable download URL = yuksek risk

# --- v44.00.47 — ATTACHMENT EXECUTABLE DETECTION -------------------------
# Ekli dosyanin filename'inde executable uzanti (SA ClamAV yerine full-body scan)
# NOT: MailScanner/Milter tarafi zaten attachment quarantine yapar; bu SA
# uzerinden extra puanlama saglar (Content-Disposition header taramasi).

full     __GWS_ATT_EXEC_EXT  /Content-Disposition:[^\n]{0,200}filename=(?:"[^"]*|)[^"\n]*\.(?:jar|exe|scr|vbs|js|msi|bat|cmd|hta|ps1|com|pif|apk|dll|lnk|wsf|jse|vbe)(?:"|\s|$)/i
score    __GWS_ATT_EXEC_EXT  9.0
describe __GWS_ATT_EXEC_EXT  Ekli dosyanin adinda dogrudan executable uzantisi

# Cift uzanti tuzagi: fatura.pdf.exe / rapor.doc.jar
full     __GWS_ATT_DOUBLE_EXT  /filename=(?:"[^"]*|)[^"\n]*\.(?:pdf|doc|docx|xls|xlsx|jpg|png|zip|rar)\.(?:jar|exe|scr|vbs|bat|cmd|msi|com)(?:"|\s|$)/i
score    __GWS_ATT_DOUBLE_EXT  10.0
describe __GWS_ATT_DOUBLE_EXT  Cift uzanti tuzagi (fatura.pdf.exe) - klasik phishing

# =============================================================================
# v44.00.56 — TYPOSQUAT + BULK SCAM DETECTION (Bangladesh RFQ / Fake Tender)
# =============================================================================
# Bu bolum "siatex1td.com" gibi rakam-harf ikame typosquat domain'leri ve
# klasik "From = To, BCC bulk" tender scam paternini yakalar.

# --- 6) Rakam-harf ikame typosquat (1→l, 0→o) domain'leri (+5.0) ----------
# Ornekler: siatex1td.com (ltd), micr0soft.com (o), g00gle.com, paypa1.com
# Sadece From/Return-Path domain'inde bu patern varsa (rakam bir kelimenin ortasinda) tetikler.
header   __GWS_TYPOSQUAT_L_AS_1  From =~ /@[a-z]{2,}1(?:td|lc|nk|ne|st|te|sa|ne|ke|ve|de|me)\b/i
score    __GWS_TYPOSQUAT_L_AS_1  5.0
describe __GWS_TYPOSQUAT_L_AS_1  Rakam-harf ikame domain (ornek: siatex1td.com — l yerine 1)

header   __GWS_TYPOSQUAT_O_AS_0  From =~ /@[a-z]*0[a-z]{2,}(?:soft|line|gle|book|mail|shop|bank|pay)\b/i
score    __GWS_TYPOSQUAT_O_AS_0  4.5
describe __GWS_TYPOSQUAT_O_AS_0  Rakam-harf ikame domain (o yerine 0)

# --- 7) Self-addressed BCC bulk pattern (From = To) --------------------------
# Ornek: From: gm@siatex1td.com, To: gm@siatex1td.com, Envelope-To: kurban@baska.com
# Bulk mailer klasigi — ama TEK BASINA firing FALSE POSITIVE uretir (meshur forward'lar
# From=To olur). Bu yuzden dusuk puan + META olarak diger sinyallerle birlestirilir.
header   __GWS_SELF_ADDRESSED  ALL =~ /^From:\s*(?:[^<\n]*<)?([^\s<>@]+@[^\s<>@,]+)>?[^\n]*$[\s\S]*?^To:\s*(?:[^<\n]*<)?\1>?/mi
score    __GWS_SELF_ADDRESSED  0.5
describe __GWS_SELF_ADDRESSED  From adresi = To adresi (BCC bulk pattern - tek basina zayif sinyal)

# Self-addressed + typosquat domain = kesin phishing (+4.5 meta)
meta     GWS_SELF_ADDRESSED_TYPOSQUAT  ( __GWS_SELF_ADDRESSED && ( __GWS_TYPOSQUAT_L_AS_1 || __GWS_TYPOSQUAT_O_AS_0 ) )
score    GWS_SELF_ADDRESSED_TYPOSQUAT  4.5
describe GWS_SELF_ADDRESSED_TYPOSQUAT  Self-addressed + typosquat domain

# Self-addressed + bulk loopback = suspicious (+3.0 meta)
meta     GWS_SELF_ADDRESSED_BULK  ( __GWS_SELF_ADDRESSED && __GWS_BULK_LOOPBACK_SEND )
score    GWS_SELF_ADDRESSED_BULK  3.0
describe GWS_SELF_ADDRESSED_BULK  Self-addressed + loopback bulk mailer

# --- 8) RFQ / Tender / Inquiry scam paterni (+3.5) --------------------------
header   __GWS_RFQ_SUBJ  Subject =~ /(?:\b(?:RFQ|inquiry\s+ref|quotation\s+request|tender\s+submission|request\s+for\s+quotation)\b)/i
score    __GWS_RFQ_SUBJ  1.0
describe __GWS_RFQ_SUBJ  Subject RFQ/tender/quotation icerir

body     __GWS_RFQ_BANGLADESH  /(?:\bDhaka\b|\bBangladesh\b|Gulshan|Niketon|Chittagong|Chattogram|\bBD\b\s+Limited)/i
score    __GWS_RFQ_BANGLADESH  1.5
describe __GWS_RFQ_BANGLADESH  Body Bangladesh/Dhaka pattern

body     __GWS_RFQ_TENDER_CTA  /(?:submission\s+deadline|tender\s+package|kindly\s+provide\s+your\s+best\s+offer|please\s+find\s+attached\s+our\s+inquiry|end\s*user\s*:.*SIATEX)/i
score    __GWS_RFQ_TENDER_CTA  1.5
describe __GWS_RFQ_TENDER_CTA  Body tender scam CTA paterni

# RFQ + Bangladesh + attachment kombosu = kesin scam (+7.0 toplam meta ile)
meta     GWS_BANGLADESH_RFQ_SCAM  ( __GWS_RFQ_SUBJ && __GWS_RFQ_BANGLADESH && __GWS_RFQ_TENDER_CTA )
score    GWS_BANGLADESH_RFQ_SCAM  4.0
describe GWS_BANGLADESH_RFQ_SCAM  Bangladesh RFQ/tender scam paterni (Siatex vs.)

# --- 9) .docx / .xlsx ekli belge + suspicious sender (+3.0) ----------------
full     __GWS_ATT_OFFICE_DOC  /Content-Disposition:[^\n]{0,200}filename=(?:"[^"]*|)[^"\n]*\.(?:docx|xlsx|pptx|docm|xlsm|pptm|dotm|xltm)(?:"|\s|$)/i
score    __GWS_ATT_OFFICE_DOC  0.1
describe __GWS_ATT_OFFICE_DOC  Ekli Office belgesi

# Office belge + typosquat sender = phishing payload olma ihtimali cok yuksek
meta     GWS_OFFICE_DOC_TYPOSQUAT  ( __GWS_ATT_OFFICE_DOC && ( __GWS_TYPOSQUAT_L_AS_1 || __GWS_TYPOSQUAT_O_AS_0 ) )
score    GWS_OFFICE_DOC_TYPOSQUAT  4.0
describe GWS_OFFICE_DOC_TYPOSQUAT  Office belgesi + typosquat gonderici = malware taşiyicisi

# Macro-enabled Office format (docm/xlsm/dotm) her zaman yuksek risk
full     __GWS_ATT_MACRO_DOC  /Content-Disposition:[^\n]{0,200}filename=(?:"[^"]*|)[^"\n]*\.(?:docm|xlsm|pptm|dotm|xltm|xlam|xll)(?:"|\s|$)/i
score    __GWS_ATT_MACRO_DOC  6.5
describe __GWS_ATT_MACRO_DOC  Macro-enabled Office belgesi (docm/xlsm) - buyuk olasilikla malware

# --- 10) Bulk mailer localhost Received hop --------------------------------
# Received: from siatex1td.com (localhost [127.0.0.1]) by mail.siatex1td.com
# Bulk mailer kendi loopback'inden gonderiyorsa suspicious.
# NOT: Roundcube/Webmail de localhost'tan gonderir — bu yuzden TEK BASINA
# yeterli sinyal DEGIL. Sadece typosquat + self-addressed ile birlikte fire eder.
header   __GWS_BULK_LOOPBACK_SEND  Received =~ /\bfrom\s+[a-z0-9.-]+\s+\(localhost\s+\[127\.0\.0\.1\]\)\s+by\s+mail\./i
score    __GWS_BULK_LOOPBACK_SEND  0.1
describe __GWS_BULK_LOOPBACK_SEND  Sender kendi loopback'inden gonderdi (zayif sinyal)

# =============================================================================
# v44.00.57 — TURKISH PASSWORD EXPIRY PHISHING (credential harvesting)
# =============================================================================
# Ornek: "info@seridokum.com Parola Suresi Dolma Bildirimi"
# "seriisdokum.com Sifre Mesaji", "Ayni sifreyi kullanin" butonu
# Bu klasik Turkish credential harvesting paterni.

header   __GWS_PW_EXPIRY_SUBJ  Subject =~ /(?:parola\s*s[uü]resi\s*dolma|sifre\s*(?:mesaj|s[uü]resi|bildirim)|parola\s*bildirim|password\s+expir|hesap.{0,20}dondur)/i
score    __GWS_PW_EXPIRY_SUBJ  3.0
describe __GWS_PW_EXPIRY_SUBJ  Turkce parola/sifre suresi phishing subject

body     __GWS_PW_EXPIRY_CTA  /(?:ayn[ıi]\s*[sş]ifreyi\s*kullan|ayn[ıi]\s*parolayi\s*kullan|ayn[ıi]\s*[sş]ifreyle\s*devam|[sş]ifre(?:yi|nizi)\s*(?:g[uü]ncelle|yenile|do[gğ]rula)|posta\s*hesab[ıi]n[ıi]z[ıi]n\s*[sş]ifresi)/i
score    __GWS_PW_EXPIRY_CTA  2.5
describe __GWS_PW_EXPIRY_CTA  Turkce "ayni sifreyi kullan" credential CTA

body     __GWS_PW_EXPIRY_URGENCY  /(?:2\s*saat\s*i[cç]inde\s*dolacak|alan\s*ad[ıi]n[ıi]z\s*engellenecek|engelleyecek|24\s*saat\s*i[cç]inde\s*(?:silinecek|dondurul)|hesab[ıi]n[ıi]z\s*devre\s*d[ıi][sş][ıi])/i
score    __GWS_PW_EXPIRY_URGENCY  1.5
describe __GWS_PW_EXPIRY_URGENCY  Aciliyet paterni (X saat icinde dolacak/silinecek)

meta     GWS_TR_CREDENTIAL_HARVEST  ( __GWS_PW_EXPIRY_SUBJ && ( __GWS_PW_EXPIRY_CTA || __GWS_PW_EXPIRY_URGENCY ) )
score    GWS_TR_CREDENTIAL_HARVEST  5.5
describe GWS_TR_CREDENTIAL_HARVEST  Turkce parola/sifre credential harvest phishing paterni

# --- 11) Extra-letter typosquat (seriisdokum vs seridokum) (+4.5) ----------
# Ornek: seri__i__sdokum.com (fazladan 'i'), y__aa__ndex.com (fazla 'a')
# Ayni harf art arda 3+ kez tekrariyorsa typosquat kokusuyor.
header   __GWS_TYPOSQUAT_EXTRA_LETTER  From =~ /@[a-z]*([a-z])\1{2,}[a-z]*\./i
score    __GWS_TYPOSQUAT_EXTRA_LETTER  1.5
describe __GWS_TYPOSQUAT_EXTRA_LETTER  Uc kez ust uste tekrarli harf iceren gonderici domain (fazla harf ekleme typosquat)

# From display name = sender domain (kendi kendini adresliyor gorsel spoof)
header   __GWS_FROM_DOM_AS_NAME  From =~ /^([a-z0-9-]+\.[a-z0-9-]+(?:\.[a-z]+)?)\s*<[^@>]+@\1>/i
score    __GWS_FROM_DOM_AS_NAME  2.5
describe __GWS_FROM_DOM_AS_NAME  From display name = ayni domain (kimlik taklidi paterni)

# Password expiry + typosquat kombosu = phishing (+7.0 meta)
meta     GWS_TR_PHISH_TYPOSQUAT_PW  ( GWS_TR_CREDENTIAL_HARVEST && ( __GWS_TYPOSQUAT_EXTRA_LETTER || __GWS_TYPOSQUAT_L_AS_1 || __GWS_FROM_DOM_AS_NAME ) )
score    GWS_TR_PHISH_TYPOSQUAT_PW  6.0
describe GWS_TR_PHISH_TYPOSQUAT_PW  Turkce sifre phishing + typosquat sender = kesin credential harvest

# HTML-only mail + password harvest = daha da suspicious
meta     GWS_TR_PHISH_HTML_ONLY  ( GWS_TR_CREDENTIAL_HARVEST && (MIME_HTML_ONLY || HTML_MESSAGE) )
score    GWS_TR_PHISH_HTML_ONLY  2.0
describe GWS_TR_PHISH_HTML_ONLY  HTML-only phishing mail credential harvest

# =============================================================================
# Kurulum sonrasi test:
#   spamassassin --lint 2>&1 | grep -i error
#   echo "Subject: Test\nFrom: paypal.com <x@evil.com>\n\ntest" | spamassassin -t
# =============================================================================
