# =============================================================================
# GökyüzüWebSpam — Custom SpamAssassin Rules (v44.00.46)
# =============================================================================
# Bu dosyayı mail sunucunuzda SpamAssassin custom rules klasörüne kopyalayın:
#   /etc/mail/spamassassin/GokyuzuWebSpam.cf    (WHM/cPanel varsayilan)
# veya
#   /var/lib/mailscanner/local.cf              (MailScanner override)
#
# Sonra SpamAssassin'i reload edin:
#   sa-compile
#   systemctl restart spamassassin
#   /usr/mailscanner/bin/check_spamassassin --lint
#
# Kural amaci: SA'nin varsayilan olarak yakalayamadigi kimlik taklidi (display
# name spoofing) ve Turk kurumsal ortama zararli phishing paterni.
# =============================================================================

# --- 1) FROM-name = alici domain'i taklidi (5.5 puan) -----------------------
# Ornekler:
#   From: handizayn.com <miya@skyverticals.com>
#   From: "your-bank.com" <hacker@evil.com>
# Bunlar klasik phishing paterni. SA cogunlukla yakalayamaz.
#
# Bu regex, From: header'da display name olarak bir domain gorurse ve o domain
# envelope-from domain'inden farkli ise +5.5 puan verir.

header  GWS_FROM_SPOOF_DISPLAY_HAS_DOMAIN  From =~ /(?:^|["\s])([a-z0-9][a-z0-9-]{1,62}\.(?:com|net|org|com\.tr|net\.tr|org\.tr|info|biz|co|io|xyz|top))\s*<[^@>]+@(?!\1)[a-z0-9.-]+>/i
score   GWS_FROM_SPOOF_DISPLAY_HAS_DOMAIN  7.5
describe GWS_FROM_SPOOF_DISPLAY_HAS_DOMAIN Display name bir domain gibi gorunuyor ama gercek gonderici farkli — kimlik taklidi

# --- 2) Kurumsal "Mailbox Full / Kota" phishing paterni (3.0 puan) ---------
# Turkce ve Ingilizce varyantlar
header   __GWS_MAILBOX_FULL_SUBJ_TR  Subject =~ /(?:posta\s*kutu(?:s[uü])?|kota|depolama).{0,20}(?:dolu|doldu|%\s*9\d|yeterli\s+alan)/i
header   __GWS_MAILBOX_FULL_SUBJ_EN  Subject =~ /(?:mailbox|storage|quota).{0,20}(?:full|exceed|limit|99\s*%)/i
meta     GWS_PHISH_MAILBOX_FULL  ( __GWS_MAILBOX_FULL_SUBJ_TR || __GWS_MAILBOX_FULL_SUBJ_EN )
score    GWS_PHISH_MAILBOX_FULL  3.0
describe GWS_PHISH_MAILBOX_FULL  Klasik "posta kutunuz dolu" phishing paterni

# --- 3) Sifre sifirlama / hesap askiya alindi paterni (2.5 puan) -----------
header   __GWS_ACCT_SUSPEND_SUBJ  Subject =~ /(?:hesab[ıi]n[ıi]z|account).{0,20}(?:ask[ıi]ya|suspend|kilit|lock|dondur)/i
score    __GWS_ACCT_SUSPEND_SUBJ  2.5
describe __GWS_ACCT_SUSPEND_SUBJ  Sifre sifirlama / hesap askiya alindi paterni

# --- 4) URL kisaltici + kurumsal from taklidi (3.5 puan) --------------------
# Butun body kisaltici link + display name kurumsal → tehlikeli
uri      __GWS_URL_SHORTENER  m{https?://(?:bit\.ly|goo\.gl|tinyurl\.com|ow\.ly|t\.co|is\.gd|buff\.ly|adf\.ly|shorte\.st|cutt\.ly)/}i
meta     GWS_SHORTENER_WITH_SPOOF  ( __GWS_URL_SHORTENER && GWS_FROM_SPOOF_DISPLAY_HAS_DOMAIN )
score    GWS_SHORTENER_WITH_SPOOF  3.5
describe GWS_SHORTENER_WITH_SPOOF  URL kisaltici + kimlik taklidi (compound risk)

# --- 5) DKIM valid ama envelope-from domain match etmiyor (2.0 puan) -------
# Attacker DKIM aliyor own domain'inde ama From header'da baska domain gosteriyor
# NOT: SA'nin DKIM_ADSP_ALL / DKIM_ADSP_DISCARD ile ust uste dusebilir; ozel
# olarak "envelope domain != From header domain" durumunu isaretler.
header   __GWS_ENV_FROM_MISMATCH  ALL =~ /^Return-Path:\s*<[^@]+@([a-z0-9.-]+)>.*?^From:\s*[^<]*<[^@]+@(?!\1)([a-z0-9.-]+)>/msi
score    __GWS_ENV_FROM_MISMATCH  2.0
describe __GWS_ENV_FROM_MISMATCH  Return-Path domain != From header domain

# =============================================================================
# v44.00.46 — MALWARE / EXECUTABLE URL DEFENSE
# =============================================================================
# Body veya URI icinde .jar/.exe/.scr/.vbs/.js/.msi/.hta gibi executable
# uzantili link → yuksek puan. Panel de ayni tesbiti yapip verdict=malware
# koyar; SA ayrica MTA seviyesinde extra guvence saglar.

uri      __GWS_URL_EXEC_EXT  m{https?://[^\s]{0,300}\.(?:jar|exe|scr|vbs|js|msi|bat|cmd|hta|ps1|com|pif|apk|dll)(?:\?|$|["'<>\s])}i
score    __GWS_URL_EXEC_EXT  6.5
describe __GWS_URL_EXEC_EXT  Body'de dogrudan calistirilabilir dosya download linki (RAT/trojan taşiyicisi)

# Google Drive / Dropbox / OneDrive dogrudan indirme URL'i - klasik payload lure
uri      __GWS_CLOUD_DL_LURE  m{(?:drive\.google\.com/(?:uc\?export=download|file/d/)|dropbox\.com/s/|onedrive\.live\.com/download|mediafire\.com/file/|wetransfer\.com/downloads/|sendspace\.com/file/)}i
score    __GWS_CLOUD_DL_LURE  4.0
describe __GWS_CLOUD_DL_LURE  Cloud file-share dogrudan indirme linki (phishing payload lure)

# Türkçe phishing tuzak metni ("dosyayı görüntüle", "belgeyi görüntüle" vs.)
body     __GWS_TR_PHISH_LURE  /(?:dosyay[ıi]\s*g[oö]r[uü]nt[uü]le|belgey[ıi]\s*g[oö]r[uü]nt[uü]le|dosyay[ıi]\s*a[cç]|belgey[ıi]\s*indir|faturay[ıi]\s*g[oö]r[uü]nt[uü]le|ekli\s*belge|ekli\s*dosya)/i

# Cloud DL + Türkçe lure kombosu (compound risk — kesin phishing)
meta     GWS_MALWARE_CLOUD_TR_LURE  ( __GWS_CLOUD_DL_LURE && __GWS_TR_PHISH_LURE )
score    GWS_MALWARE_CLOUD_TR_LURE  5.5
describe GWS_MALWARE_CLOUD_TR_LURE  Turkce "dosyayi goruntule" + cloud indirme linki = kesin phishing

# Executable URL + Türkçe lure kombosu
meta     GWS_MALWARE_EXEC_TR_LURE  ( __GWS_URL_EXEC_EXT && __GWS_TR_PHISH_LURE )
score    GWS_MALWARE_EXEC_TR_LURE  4.0
describe GWS_MALWARE_EXEC_TR_LURE  Turkce lure + executable download URL = yuksek risk

# --- v44.00.47 — ATTACHMENT EXECUTABLE DETECTION -------------------------
# Ekli dosyanin filename'inde executable uzanti (SA ClamAV yerine full-body scan)
# NOT: MailScanner/Milter tarafi zaten attachment quarantine yapar; bu SA
# uzerinden extra puanlama saglar (Content-Disposition header taramasi).

full     __GWS_ATT_EXEC_EXT  /Content-Disposition:[^\n]{0,200}filename=(?:"[^"]*|)[^"\n]*\.(?:jar|exe|scr|vbs|js|msi|bat|cmd|hta|ps1|com|pif|apk|dll|lnk|wsf|jse|vbe)(?:"|\s|$)/i
score    __GWS_ATT_EXEC_EXT  9.0
describe __GWS_ATT_EXEC_EXT  Ekli dosyanin adinda dogrudan executable uzantisi

# Cift uzanti tuzagi: fatura.pdf.exe / rapor.doc.jar
full     __GWS_ATT_DOUBLE_EXT  /filename=(?:"[^"]*|)[^"\n]*\.(?:pdf|doc|docx|xls|xlsx|jpg|png|zip|rar)\.(?:jar|exe|scr|vbs|bat|cmd|msi|com)(?:"|\s|$)/i
score    __GWS_ATT_DOUBLE_EXT  10.0
describe __GWS_ATT_DOUBLE_EXT  Cift uzanti tuzagi (fatura.pdf.exe) - klasik phishing

# =============================================================================
# Kurulum sonrasi test:
#   spamassassin --lint 2>&1 | grep -i error
#   echo "Subject: Test\nFrom: paypal.com <x@evil.com>\n\ntest" | spamassassin -t
# =============================================================================
